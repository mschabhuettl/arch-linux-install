# hosts/nb-nee.env - NB-Nicola (laptop, Intel iGPU)
# shellcheck shell=bash
# shellcheck disable=SC2034

HOSTNAME="NB-Nicola"
SWAP_SIZE="32G"
ROOT_SIZE="512G"

# Different user on this machine; keep the established UID.
USERNAME="nee"
USER_UID="1001"

UCODE="intel"         # amd | intel
GPU="intel"           # nvidia | amdgpu | intel
TIMESYNC="chrony"     # timesyncd | chrony
POWER="tlp"           # ppd (power-profiles-daemon) | tlp

MODULES_EXTRA=()
# sof-firmware: Sound Open Firmware for the Intel audio DSP.
EXTRA_PKGS=(sof-firmware)
CMDLINE_EXTRA=""
