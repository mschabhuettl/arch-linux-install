# hosts/pc.env - PC-Matthias (desktop, NVIDIA, 10GbE)
# shellcheck shell=bash
# shellcheck disable=SC2034

HOSTNAME="PC-Matthias"
SWAP_SIZE="256G"
ROOT_SIZE="512G"

GPU="nvidia"          # nvidia | amdgpu
TIMESYNC="timesyncd"  # timesyncd | chrony
POWER="ppd"           # ppd (power-profiles-daemon) | tlp

# Extra modules embedded into the initramfs (atlantic: AQC 10GbE NIC).
MODULES_EXTRA=(atlantic)

# Host-only packages, installed in the same transaction as COMMON_PKGS.
# linux-headers + dkms are needed for nvidia-open-dkms.
EXTRA_PKGS=(linux-headers dkms)

# Appended to the end of the kernel command line.
CMDLINE_EXTRA=""
