# hosts/nb.env - NB-Matthias (laptop, AMD iGPU)
# shellcheck shell=bash
# shellcheck disable=SC2034

HOSTNAME="NB-Matthias"
SWAP_SIZE="64G"
ROOT_SIZE="512G"

GPU="amdgpu"          # nvidia | amdgpu
# chrony instead of systemd-timesyncd: deliberate choice for this machine
# (copes better with suspend/resume cycles and changing networks).
TIMESYNC="chrony"     # timesyncd | chrony
POWER="tlp"           # ppd (power-profiles-daemon) | tlp

MODULES_EXTRA=()
EXTRA_PKGS=()
CMDLINE_EXTRA=""
